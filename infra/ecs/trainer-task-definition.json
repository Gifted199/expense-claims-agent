{
  "family": "akinsds1126-expense-trainer",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::666127452756:role/akinsds1126-expense-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::666127452756:role/akinsds1126-expense-trainer-task-role",
  "containerDefinitions": [
    {
      "name": "trainer",
      "image": "666127452756.dkr.ecr.eu-west-2.amazonaws.com/akinsds1126-expense-trainer:431e8b4eff9198345473c5ce8edd0008be964d0d",
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "eu-west-2"
        },
        {
          "name": "EXPENSE_ARTIFACT_BUCKET",
          "value": "akinsds1126-expense-artifacts"
        }
      ],
      "readonlyRootFilesystem": false,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/akinsds1126-expense-trainer",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "trainer"
        }
      }
    }
  ]
}
